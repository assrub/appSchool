    {
      "id": "negative",
      "title": "Negativo (am not / isn't / aren't)",
      "exerciseType": "fill-blank",
      "explanation": "Para negar, agregá NOT. I am not (no se acorta), isn't = is+not, aren't = are+not.",
      "inputMode": "tap",
      "theory": {
        "text": "Para decir que algo NO ES o NO ESTÁ, solo agregá NOT.",
        "sections": [
          {
            "title": "I + am not",
            "text": "Solo para I. No se acorta.",
            "examples": [
              "I am not a doctor.",
              "I am not tired."
            ]
          },
          {
            "title": "is + not = isn't",
            "text": "Para He, She, It o un nombre solo.",
            "examples": [
              "He isn't at school.",
              "She isn't sad."
            ]
          },
          {
            "title": "are + not = aren't",
            "text": "Para You, We, They o plurales.",
            "examples": [
              "They aren't here.",
              "We aren't ready."
            ]
          }
        ],
        "table": {
          "headers": [
            "Forma",
            "Negación corta"
          ],
          "rows": [
            [
              "am not",
              "am not (no se acorta)"
            ],
            [
              "is not",
              "isn't"
            ],
            [
              "are not",
              "aren't"
            ]
          ]
        },
        "tips": [
          {
            "emoji": "❌",
            "text": "am not → Solo I"
          },
          {
            "emoji": "✂️",
            "text": "isn't = is+not"
          },
          {
            "emoji": "✂️",
            "text": "aren't = are+not"
          }
        ]
      },
